{
  "name": "travel",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=22.23" },
  "scripts": {
    "build": "node web/scripts/with-root-env.mjs pnpm --dir web build",
    "dev": "node web/scripts/with-root-env.mjs pnpm --dir web dev",
    "start": "node web/scripts/with-root-env.mjs pnpm --dir web start",
    "test": "pnpm -r test",
    "db:up": "node core/bin/db-local.ts up",
    "db:down": "node core/bin/db-local.ts down",
    "db:reset": "node core/bin/db-local.ts reset",
    "db:migrate": "node core/bin/db-local.ts migrate",
    "db:status": "node core/bin/db-local.ts status",
    "db:psql": "node core/bin/db-local.ts psql",
    "db:test": "node core/bin/db-local.ts test",
    "db:url": "node core/bin/db-local.ts url"
  },
  "dependencies": { "@neon/config": "^1.9.3", "@neon/env": "^1.6.4" }
}
