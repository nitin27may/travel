{
  "name": "@travel/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/images.mjs && node scripts/og.mjs",
    "start": "next start",
    "build:fixture": "node scripts/build-fixture.mjs",
    "budget:report": "node scripts/budget-report.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "snapshot": "node scripts/snapshot-prototype.mjs",
    "snapshot:check": "node scripts/snapshot-prototype.mjs --check",
    "tag-conflicts": "WRITE_TAG_REPORT=1 vitest run tests/data/tag-conflicts.test.ts --config vitest.report.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@neon/realtime": "0.1.2",
    "@neon/realtime-react": "0.1.1",
    "@neondatabase/auth": "0.7.0-beta",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "@travel/core": "workspace:*",
    "maplibre-gl": "6.11.2",
    "motion": "14.0.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
