{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RowMeta v1",
  "description": "Generated by node core/bin/schema.ts generate from core/src/schema/rowMeta.ts. Do not edit by hand. The row-level metadata of every catalogue and research table (docs/v2/features/catalogue-intake-and-storage.md 3.3); internal, never granted to the app role.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "first_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "imported_from": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._\\-/]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:s-[0-9a-f]{10}|src-\\d{4,})$"
      }
    },
    "observed_on": {
      "type": "string",
      "format": "date"
    },
    "basis": {
      "type": "string",
      "enum": [
        "operator_rule",
        "official_rule",
        "official_grade",
        "official_info",
        "community",
        "our_inference",
        "operator_info"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "read",
        "crawl",
        "api",
        "computed",
        "owner"
      ]
    },
    "estimate": {
      "type": "boolean"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "proposed",
        "agent_checked",
        "sample_checked",
        "person_checked",
        "approved",
        "rejected"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "searched_none": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "on": {
            "type": "string",
            "format": "date"
          },
          "tried": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "what",
          "on",
          "tried"
        ],
        "additionalProperties": false
      }
    },
    "original": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "raw_ref": {
      "type": "string",
      "pattern": "^research\\/inbox\\/[A-Za-z0-9._\\-/ ]+$"
    },
    "research_ref": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^research\\/(?:trips|runs)\\/[A-Za-z0-9._\\-/]+(?:#[A-Za-z0-9._\\-]+)?$"
      }
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,40}$"
    },
    "work_tags": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "freshness_class": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private"
      ]
    },
    "origin": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      },
      "required": [
        "from",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-max-bytes": 4096,
  "x-warn-bytes": 1024,
  "x-tables": [
    "area",
    "town",
    "operator",
    "entity",
    "entity_alias",
    "offer",
    "relation",
    "entity_link",
    "track",
    "condition_report",
    "event_occurrence",
    "source",
    "dataset_file",
    "record_doc",
    "source_local",
    "capture_supersede",
    "evidence",
    "media",
    "suitability",
    "relevance",
    "relevance_signal",
    "type_node",
    "tag",
    "relevance_class",
    "research_gap",
    "change",
    "changeset"
  ],
  "x-private-tables": [
    "saved_source",
    "collection"
  ],
  "x-keys": [
    {
      "key": "schema_version",
      "since": 1,
      "required": "always",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "record_id",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": [
        "evidence",
        "track",
        "media",
        "entity_link",
        "research_gap"
      ]
    },
    {
      "key": "run_id",
      "since": 1,
      "required": "loaded",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "first_run_id",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "imported_from",
      "since": 1,
      "required": "loaded",
      "privacy": "internal",
      "tables": "all",
      "stamp": "loader"
    },
    {
      "key": "imported_at",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all",
      "stamp": "loader"
    },
    {
      "key": "source_ids",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "observed_on",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "basis",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "method",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "estimate",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "review_state",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "conflicts",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "searched_none",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "original",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "raw_ref",
      "since": 1,
      "required": "optional",
      "privacy": "private",
      "tables": [
        "saved_source",
        "collection"
      ]
    },
    {
      "key": "research_ref",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "license",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "work_tags",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "last_checked",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "freshness_class",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "ttl_days",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "privacy_class",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    },
    {
      "key": "origin",
      "since": 1,
      "required": "optional",
      "privacy": "internal",
      "tables": "all"
    }
  ]
}
