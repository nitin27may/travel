{
  "name": "travel-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "worker": "vite build -c vite.worker.config.ts --logLevel warn",
    "dev": "npm run worker && vite",
    "build": "npm run worker && tsc --noEmit && vite build",
    "build:single": "npm run worker && vite build --mode single && cp public/*.webp dist-single/",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:single && node scripts/artifact.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "fractional-indexing": "4.0.0",
    "maplibre-gl": "6.11.2",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
