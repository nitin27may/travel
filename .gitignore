# publish.sh output, regenerated by ./publish.sh
.site/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp

# Local secrets, never commit
.env
.env.*

# regenerable: Commons candidate lists (cached under /tmp/gal), checker reports, theme gallery
*-candidates.json
links-report.txt
legacy/_system/gallery.html

# wrangler CLI cache (created by project/deployment list commands)
.wrangler/

# raw boundary and gazetteer downloads for the globe build (regenerable)
tools/.cache/

# node
node_modules/

# web (P3a)
web/out/
web/.next/
web/.generated/
web/.fixture-*/

# relevance: a private origin for the 2 km household check, local only
data/relevance/inputs/private-origin.local.json

# written by next dev
web/AGENTS.md
